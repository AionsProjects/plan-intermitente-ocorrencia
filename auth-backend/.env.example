# Backend de autenticacao — envs lidas em RUNTIME (nao sao VITE_*; nunca vao pro bundle).
PORT=3000

# Postgres (banco unico, schema pi). Valor real so na env do Vercel / .env (gitignored).
# Dev local: postgres://postgres:senha@localhost:5432/db
DATABASE_URL=postgres://USUARIO:SENHA@SEU_HOST:PORTA/BANCO
# 1 se o Postgres exigir SSL (cloudfy atual NAO exige -> 0)
DB_SSL=0

# Google OAuth (Workspace contatoserv.com.br) — criar Client ID tipo "Web application"
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=troque_este_secret
# Redirect autorizado no Google Cloud Console:
#   local: http://localhost:8081/auth/google/callback
#   prod:  http://192.168.0.41:8081/auth/google/callback
OAUTH_REDIRECT_URI=http://localhost:8081/auth/google/callback

# Pra onde mandar apos login OK
APP_BASE_URL=/

# Restricao de dominio (quem pode logar por auto-provisao)
AUTH_ALLOWED_DOMAIN=contatoserv.com.br

# Sessao
SESSION_COOKIE_NAME=pi_sess
SESSION_TTL_DIAS=10
# Cookie Secure: 0 na VM HTTP puro; 1 so quando tiver TLS
COOKIE_SECURE=0

# 1o Admin (CONFIRMAR email real). RH/OP vem do onboarding; DP/Admin promovidos no painel.
SEED_ADMIN_EMAIL=admin@contatoserv.com.br

# Bypass de login Google p/ testes locais (NUNCA 1 em producao)
AUTH_DEV_BYPASS=0

# ---- Integrações (cred dos nós n8n; valores reais só no .env, NUNCA versionar) ----
MONDAY_TOKEN=          # cred "Ray0"
MONDAY_API_VERSION=2024-10
# Ponte AIONS RM
RM_BRIDGE_URL=         # ex https://<reservado>.ngrok-free.dev
RM_AIONS_AUTH=         # header AIONS-AUTH
# RM TOTVS DIRETO (Basic Auth) — leituras SQL e (com RM_ESCRITA_DIRETA=1) escrita SOAP.
# A ponte acima vira fallback.
RM_DIRETO_URL=         # ex https://contatoservicos165112.rm.cloudtotvs.com.br:8051
RM_DIRETO_USER=        # usuario RM
RM_DIRETO_PASS=        # senha RM (secret — nunca commitar)
RM_DATA_SERVER=        # nome do data server RM
# Google Drive (service account compartilhada na pasta raiz)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=        # JSON completo em uma linha
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_BASE64= # alternativa ao JSON puro
GOOGLE_DRIVE_ROOT_FOLDER_ID=              # pasta raiz do arquivo intermitente
# Caju (OAuth password grant)
CAJU_AUTH_URL=
CAJU_API_BASE=https://services.caju.com.br/partners/v1
CAJU_CLIENT_ID=
CAJU_CLIENT_SECRET=
CAJU_GRANT_TYPE=password
CAJU_USERNAME=
CAJU_PASSWORD=
CAJU_SPONSOR_ID=
CAJU_INTEGRATION_ID=
# Cron (protege /api/jobs/tick)
CRON_SECRET=

# Mensal durável. Mantenha produção desligada até concluir a homologação e a paridade.
MENSAL_WORKFLOW_ENABLED=0
MENSAL_MODO=homologacao
MENSAL_PRODUCTION_ENABLED=0
# Escrita RM direta (SOAP wsDataServer/wsProcess). Default 0 = tudo continua pela ponte.
RM_ESCRITA_DIRETA=0
RM_COD_USUARIO=003080
RM_SOAP_TIMEOUT_MS=45000
RM_SOAP_TIMEOUT_PROCESSO_MS=120000
# Espera entre lotes do histórico RM (ms). 0 automático em homologação.
MENSAL_RM_ESPERA_LOTE_MS=15000
