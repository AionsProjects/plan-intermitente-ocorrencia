{
  "name": "plano-intermitentes-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de autenticacao (SSO Google Workspace + Postgres) do app de Intermitentes",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --env-file=.env --env-file=.env.test --import tsx --test src/**/*.test.ts",
    "start": "node dist/server.js",
    "migrate": "node --env-file=.env --import tsx src/scripts/migrate.ts",
    "limpar:teste": "node --env-file=.env --import tsx src/scripts/limpar-teste-convocacao.ts",
    "conferir:prepag": "node --env-file=.env --import tsx src/scripts/conferir-prepagamento.ts",
    "patch:virada": "node --env-file=.env --import tsx src/scripts/patch-virada-remover-wf5.ts",
    "seed": "node --env-file=.env --import tsx src/scripts/seed.ts",
    "registrar-boards": "node --env-file=.env --import tsx src/scripts/registrar-boards.ts",
    "virada:remapear": "node --env-file=.env --import tsx src/scripts/virada-remapear-rm.ts",
    "token:servico": "node --env-file=.env --import tsx src/scripts/token-servico.ts",
    "rm:schema": "node --env-file=.env --import tsx src/scripts/rm-schema.ts",
    "rm:readview": "node --env-file=.env --import tsx src/scripts/rm-readview.ts",
    "rm:readrecord": "node --env-file=.env --import tsx src/scripts/rm-readrecord.ts",
    "rm:prevoo": "node --env-file=.env --import tsx src/scripts/rm-prevoo-convocacao.ts",
    "rm:teste-convocacao": "node --env-file=.env --import tsx src/scripts/rm-teste-convocacao.ts",
    "rm:teste-bifurcacao": "node --env-file=.env --import tsx src/scripts/rm-teste-bifurcacao.ts",
    "rm:teste-parcial": "node --env-file=.env --import tsx src/scripts/rm-teste-parcial.ts",
    "rm:delete": "node --env-file=.env --import tsx src/scripts/rm-delete.ts",
    "rm:atestados": "node --env-file=.env --import tsx src/scripts/rm-atestados.ts",
    "importar:convocacoes": "node --env-file=.env --import tsx src/scripts/importar-convocacoes.ts",
    "migrate:dist": "node dist/scripts/migrate.js",
    "seed:dist": "node dist/scripts/seed.js",
    "relatorio": "node --env-file=.env --import tsx src/scripts/relatorio-periodo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
